<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width={{ width }}, height={{ height }}, initial-scale=1.0" />
    <title>{{ data.story_title }}</title>
    <script src="assets/gsap.min.js"></script>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body, html { width: {{ width }}px; height: {{ height }}px; overflow: hidden; background: #0f172a; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
      #root { position: relative; width: {{ width }}px; height: {{ height }}px; overflow: hidden; background: linear-gradient(180deg, #1e1b4b 0%, #0f172a 100%); }
      {{ styles_css }}
    </style>
  </head>
  <body>
    <div id="root"
         data-composition-id="main"
         data-start="0"
         data-duration="{{ total_duration }}"
         data-width="{{ width }}"
         data-height="{{ height }}">

      <!-- Header Title Banner -->
      <div id="title-banner" class="story-title-banner clip" data-start="0" data-duration="{{ total_duration }}" data-track-index="2">
        📖 {{ data.story_title }}
      </div>

      <!-- Character Bi Illustration -->
      <div id="character-illustration" class="character-wrapper clip"
           data-start="0.3"
           data-duration="{{ total_duration - 0.3 }}"
           data-track-index="1">
        <img src="assets/character.png" alt="Sóc Bi" class="character-img" />
      </div>

      <!-- Book Page Reading -->
      <div id="book-page" class="book-page-wrapper clip" data-start="0.5" data-duration="{{ total_duration - 0.5 }}" data-track-index="2">
        <p class="story-body">{{ data.book_page_text }}</p>
      </div>

      <!-- Moral Lesson -->
      <div id="moral" class="moral-box clip" data-start="1.8" data-duration="{{ total_duration - 1.8 }}" data-track-index="2">
        ✨ Bài học: {{ data.moral_lesson }}
      </div>

      <!-- Voiceover Audio -->
      <audio id="audio-voiceover" class="clip" src="{{ voiceover_src or 'assets/voiceover.mp3' }}" data-start="0" data-duration="{{ total_duration }}" data-track-index="3"></audio>
    </div>

    <script>
      window.__timelines = window.__timelines || {};
      const tl = gsap.timeline({ paused: true });
      tl.fromTo("#title-banner", { y: -50, opacity: 0 }, { y: 0, opacity: 1, duration: 0.45, ease: "back.out(1.6)" }, 0.1);
      tl.fromTo("#character-illustration", { scale: 0.8, opacity: 0, y: 30 }, { scale: 1, opacity: 1, y: 0, duration: 0.5, ease: "power2.out" }, 0.3);
      tl.fromTo("#book-page", { scale: 0.9, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.5, ease: "power2.out" }, 0.5);
      tl.fromTo("#moral", { y: 30, opacity: 0 }, { y: 0, opacity: 1, duration: 0.4, ease: "back.out(1.5)" }, 1.8);
      window.__timelines["main"] = tl;
      tl.seek(0);
    </script>
  </body>
</html>
