<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width={{ width }}, height={{ height }}, initial-scale=1.0" />
    <title>{{ data.fact_question or "Kiến Thức Thú Vị" }}</title>
    <script src="assets/gsap.min.js"></script>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body, html { width: {{ width }}px; height: {{ height }}px; overflow: hidden; background: #030712; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
      #root { position: relative; width: {{ width }}px; height: {{ height }}px; overflow: hidden; background: radial-gradient(circle at 50% 20%, #172554 0%, #030712 100%); }
      {{ styles_css }}
    </style>
  </head>
  <body>
    <div id="root"
         data-composition-id="main"
         data-start="0"
         data-duration="{{ total_duration }}"
         data-width="{{ width }}"
         data-height="{{ height }}">

      <!-- Background Animated Glow Orbs -->
      <div id="orb1" class="bg-glow-orb-1 clip" data-start="0" data-duration="{{ total_duration }}" data-track-index="0"></div>
      <div id="orb2" class="bg-glow-orb-2 clip" data-start="0" data-duration="{{ total_duration }}" data-track-index="0"></div>

      <!-- Hook Top Badge -->
      <div id="fact-hook" class="fact-badge-top clip" data-start="0" data-duration="{{ total_duration }}" data-track-index="2">
        💡 {{ data.fact_question or "BẠN CÓ BIẾT ĐIỀU NÀY?" }}
      </div>

      <!-- Kinetic Stat Big Number -->
      <div id="stat-box" class="stat-number-box clip" data-start="0.4" data-duration="{{ total_duration - 0.4 }}" data-track-index="2">
        <div id="stat-num" class="giant-number">{{ data.stat_number or "10.000" }}</div>
        <div id="unit" class="unit-label">HẠT DẺ MỖI MÙA THU</div>
      </div>

      <!-- Fact Statement Glass Card -->
      <div id="statement" class="statement-card clip" data-start="1.6" data-duration="{{ total_duration - 1.6 }}" data-track-index="2">
        <div class="statement-text">{{ data.fact_statement or "Mỗi chú sóc nhỏ có thể giấu hơn 10.000 hạt dẻ mỗi mùa thu và nhớ chính xác vị trí nhờ khứu giác siêu phàm!" }}</div>
        <div class="cta-text">
          <span>❤️</span>
          <span>{{ data.follow_cta or "Thả tim và follow Sóc Nhỏ TV nhé!" }}</span>
        </div>
      </div>

      <audio id="audio-voiceover" class="clip" src="{{ voiceover_src or 'assets/voiceover.mp3' }}" data-start="0" data-duration="{{ total_duration }}" data-track-index="3"></audio>
    </div>

    <script>
      window.__timelines = window.__timelines || {};
      const tl = gsap.timeline({ paused: true });

      // Kinetic Typography animations
      tl.fromTo("#fact-hook", { y: -40, opacity: 0 }, { y: 0, opacity: 1, duration: 0.35, ease: "back.out(1.8)" }, 0.1);
      tl.fromTo("#stat-box", { scale: 0.2, rotation: -12, opacity: 0 }, { scale: 1, rotation: 0, opacity: 1, duration: 0.5, ease: "back.out(2)" }, 0.4);
      tl.fromTo("#unit", { y: 20, opacity: 0 }, { y: 0, opacity: 1, duration: 0.35, ease: "power2.out" }, 0.7);
      tl.fromTo("#statement", { y: 60, opacity: 0 }, { y: 0, opacity: 1, duration: 0.45, ease: "power2.out" }, 1.6);

      // Subtle float animation for orbs
      tl.to("#orb1", { x: 30, y: 20, duration: 2.5, ease: "sine.inOut", yoyo: true, repeat: -1 }, 0);
      tl.to("#orb2", { x: -30, y: -20, duration: 2.8, ease: "sine.inOut", yoyo: true, repeat: -1 }, 0);

      window.__timelines["main"] = tl;
      tl.seek(0);
    </script>
  </body>
</html>
