<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width={{ width }}, height={{ height }}, initial-scale=1.0" />
    <title>{{ data.title or "Học Vẽ Whiteboard" }}</title>
    <script src="assets/gsap.min.js"></script>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body, html { width: {{ width }}px; height: {{ height }}px; overflow: hidden; background: #f1f5f9; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
      #root { position: relative; width: {{ width }}px; height: {{ height }}px; overflow: hidden; }
      {{ styles_css }}
    </style>
  </head>
  <body>
    <div id="root"
         data-composition-id="main"
         data-start="0"
         data-duration="{{ total_duration }}"
         data-width="{{ width }}"
         data-height="{{ height }}">

      <div class="whiteboard-frame">
        <!-- Header -->
        <div id="hdr" class="whiteboard-header clip" data-start="0" data-duration="{{ total_duration }}" data-track-index="2">
          {{ data.title or "🎨 HỌC VẼ CÙNG SÓC NHỎ BI" }}
        </div>

        <!-- Video Drawing Stage -->
        <div id="stage" class="drawing-stage clip" data-start="0.2" data-duration="{{ total_duration - 0.2 }}" data-track-index="2">
          <video id="wb-vid" class="whiteboard-video" src="assets/whiteboard.mp4" playsinline muted preload="auto"></video>
        </div>

        <!-- Instruction Pill -->
        <div id="instruction" class="instruction-pill clip" data-start="0.5" data-duration="{{ total_duration - 0.5 }}" data-track-index="2">
          <div class="step-label">{{ data.step_badge or "BƯỚC 1: PHÁC THẢO NÉT CƠ BẢN" }}</div>
          <div class="caption-text">{{ data.caption or "Bé hãy vẽ hình tròn trước, rồi thêm đôi tai tam giác nha!" }}</div>
        </div>
      </div>

      <audio id="audio-voiceover" class="clip" src="{{ voiceover_src or 'assets/voiceover.mp3' }}" data-start="0" data-duration="{{ total_duration }}" data-track-index="3"></audio>
    </div>

    <script>
      window.__timelines = window.__timelines || {};
      const tl = gsap.timeline({ paused: true });
      tl.fromTo("#hdr", { y: -30, opacity: 0 }, { y: 0, opacity: 1, duration: 0.35, ease: "power2.out" }, 0.1);
      tl.fromTo("#stage", { scale: 0.9, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.4, ease: "power2.out" }, 0.2);
      tl.fromTo("#instruction", { y: 40, opacity: 0 }, { y: 0, opacity: 1, duration: 0.45, ease: "power2.out" }, 0.5);
      window.__timelines["main"] = tl;
      tl.seek(0);
    </script>
  </body>
</html>
