      "stars": 261,
      "pushed_at": "2026-09-08"
    },
    {
      "name": "handanim",
      "repo": "subroy13/handanim",
      "license": "MIT",
      "stars": 50,
      "pushed_at": "2026-11-05"
    }
  ],
  "learned_from": [
    "whiteboard-stroke-revelation"
  ]
}
