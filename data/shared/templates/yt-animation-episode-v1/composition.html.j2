{# design_scale: 1 — template thiết kế trực tiếp trên khung 1920x1080 #}
<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width={{ width }}, height={{ height }}, initial-scale=1.0" />
    <title>{{ data.episode_title }}</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body, html { width: {{ width }}px; height: {{ height }}px; overflow: hidden; background: #030712; font-family: -apple-system, sans-serif; }
      #root { position: relative; width: {{ width }}px; height: {{ height }}px; overflow: hidden; }
      {{ styles_css }}
    </style>
  </head>
  <body>
    <div id="root"
         data-composition-id="main"
         data-start="0"
         data-duration="{{ total_duration }}"
         data-width="{{ width }}"
         data-height="{{ height }}">

      <!-- Intro Title Card (4s) -->
      <div id="title-card" class="title-card-wrapper clip" data-start="0" data-duration="4.0" data-track-index="2">
        <div class="ep-badge">{{ data.episode_number or "TẬP 01" }}</div>
        <div class="ep-title">{{ data.episode_title }}</div>
        <div class="scale-lock-note">🔒 {{ data.character_scale_lock or "Sóc Nhỏ 100cm · Bạn Koala 150cm" }}</div>
      </div>

      <!-- Outro End Screen (Cuối 5s) -->
      <div id="outro" class="outro-container clip" data-start="{{ [total_duration - 5.0, 4.2]|max }}" data-duration="{{ [total_duration - ([total_duration - 5.0, 4.2]|max), 0.5]|max }}" data-track-index="2">
        <div class="outro-text">🔔 {{ data.end_screen_cta or "Đăng ký kênh Sóc Nhỏ TV" }}</div>
        <div class="sub-btn">ĐĂNG KÝ</div>
      </div>

      <audio id="audio-voiceover" class="clip" src="{{ voiceover_src }}" data-start="0" data-duration="{{ total_duration }}" data-track-index="3"></audio>
      {% if bgm_src %}
      <audio id="audio-bgm" class="clip" src="{{ bgm_src }}" data-start="0" data-duration="{{ total_duration }}" data-track-index="4" data-volume="0.18"></audio>
      {% endif %}
    </div>

    <script>
      window.__timelines = window.__timelines || {};
      const tl = gsap.timeline({ paused: true });
      tl.fromTo("#title-card", { scale: 0.85, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.6, ease: "power2.out" }, 0.2);
      tl.to("#title-card", { opacity: 0, duration: 0.4 }, 3.6);
      tl.fromTo("#outro", { y: 60, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, ease: "power2.out" }, {{ [total_duration - 5.0, 4.2]|max }});
      window.__timelines["main"] = tl;
      tl.seek(0);
    </script>
  </body>
</html>
