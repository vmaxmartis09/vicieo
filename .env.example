# Khóa API, không commit
GEMINI_API_KEY=
SOCNHOTV_SPEND_CAP_USD=1

# Chuỗi backend sinh kịch bản, thử lần lượt từ trái sang phải khi lỗi/hết quota.
# Mặc định ưu tiên CLI (dùng phiên đăng nhập sẵn có), Gemini API có phí đứng cuối:
# SOCNHOTV_SCRIPT_LLM_CHAIN=gemini-cli,claude-cli,gemini-api
# Model cho Gemini CLI và danh sách model xoay vòng cho Gemini API:
# SOCNHOTV_GEMINI_CLI_MODEL=gemini-3.5-flash
# SOCNHOTV_TEXT_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.8-flash
# Nhiều khóa để xoay khi hết quota: GEMINI_API_KEYS=key1,key2 hoặc GEMINI_API_KEY_2=...
